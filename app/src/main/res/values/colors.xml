<resources>
    <color name="colorPrimary">#008577</color>
    <color name="colorPrimaryDark">#FFB137</color>
    <color name="colorAccent">#D81B60</color>
    <color name="gray">#A6A6A6</color>
    <color name="white">#ffff</color>
    <color name="black">#000000</color>

    <color name="colorDialogTransclucent">#8f000000</color>

    <!-- Neutral shades used when the screen shows the theme background instead of a user
         picked color. Which set applies follows the color actually painted, not the night
         mode: in dark mode the screen turns white while a light is on, and then the light
         shades are the readable ones. -->
    <color name="neutral_surface_light">#EFEFF1</color>
    <color name="neutral_surface_raised_light">#FFFFFF</color>
    <color name="neutral_track_light">#F3F3F7</color>

    <color name="neutral_surface_dark">#2A2A2E</color>
    <color name="neutral_surface_raised_dark">#3A3A40</color>
    <color name="neutral_track_dark">#2E2E33</color>

    <!-- The guided tour. The scrim is the app accent turned almost opaque, so it reads the same
         way in either theme and only the highlight cut out of it shows the screen behind. The
         caption and its buttons are plain cream text on top of it, with a white ring drawn around
         the cut out so the highlighted control stands apart from the screen showing through. -->
    <color name="showcase_scrim">#F5FFB137</color>
    <color name="showcase_on_scrim">#FFF8EC</color>
    <color name="showcase_on_scrim_muted">#CCFFF8EC</color>
    <color name="showcase_highlight_ring">#FFFFFFFF</color>
</resources>
