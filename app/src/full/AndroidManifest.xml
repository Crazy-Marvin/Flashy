<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only the `full` flavour ships the Nothing Glyph SDK (app/libs), so everything the SDK
         needs in the manifest lives in this flavour overlay and is merged in for it alone. -->

    <!-- Lets the app drive the Glyph lights on a Nothing phone. Ignored everywhere else. -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- The Glyph SDK declares minSdk 33. The app keeps its own minimum and only calls into the
         SDK on Nothing phones, so the higher minimum of the library is overridden here. -->
    <uses-sdk tools:overrideLibrary="com.nothing.thirdparty" />

    <application>
        <!-- Authorises the Glyph strips of Phone (1)/(2)/(2a)/(3a). The key is issued by Nothing's
             developer programme; until one is filled in below those phones simply refuse to hand
             out the Glyph and the feature stays off there. The Glyph Matrix of Phone (3) is
             authorised by the permission above instead and needs no key. The entry itself has to
             exist either way, because the SDK reads it unconditionally. -->
        <meta-data
            android:name="NothingKey"
            android:value="@string/nothing_glyph_key" />
    </application>

</manifest>
